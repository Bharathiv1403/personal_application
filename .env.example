# AAYON Executive Personal Life OS - Environment Variables Template
EXPO_PUBLIC_APP_ENV=development

# -------------------------------------------------------------
# FREE AI ENGINES (Provide one or more for automatic failover)
# -------------------------------------------------------------

# 1. Google Gemini (100% Free - 1,500 req/day from https://aistudio.google.com)
EXPO_PUBLIC_GEMINI_API_KEY=your_gemini_api_key_here

# 2. Groq Cloud (Ultra-Fast Llama 3.3 70B - 14,400 req/day from https://console.groq.com)
EXPO_PUBLIC_GROQ_API_KEY=your_groq_api_key_here

# 3. Hugging Face Serverless (Free from https://huggingface.co/settings/tokens)
EXPO_PUBLIC_HUGGINGFACE_API_KEY=

# 4. Ollama Local/Tunnel URL (e.g. http://192.168.1.5:11434 or cloudflare tunnel)
EXPO_PUBLIC_OLLAMA_URL=
EXPO_PUBLIC_OLLAMA_MODEL=llama3.2

# -------------------------------------------------------------
# OTHER SERVICES
# -------------------------------------------------------------
EXPO_PUBLIC_WEATHER_API_KEY=your_weather_api_key_here
EXPO_PUBLIC_GOOGLE_CLIENT_ID=your_oauth_client_id_here
